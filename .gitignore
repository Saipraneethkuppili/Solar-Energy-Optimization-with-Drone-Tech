logs/
*.log

# Build
build/
dist/
*.egg

# Models
models/checkpoints/*.pt
models/checkpoints/*.pth
models/checkpoints/*.onnx

# Large datasets
datasets/raw/*
datasets/processed/*

# Keep folder structure
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep
!datasets/sample/.gitkeep

# Secrets
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# Docker
*.pid

# Temporary
tmp/
temp/

# Raspberry Pi
*.dbruns/
